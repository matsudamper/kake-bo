# kotlin_labs を link しないと全ディレクティブが暗黙に取り込まれ、バックエンドの @optional と衝突するため何も import せずに link する
extend schema @link(url: "https://specs.apollo.dev/kotlin_labs/v0.3", import: [])
extend schema @link(url: "https://specs.apollo.dev/cache/v0.4", import: ["@typePolicy"])

extend type UserMail @typePolicy(keyFields: "id")
extend type MoneyUsageCategory @typePolicy(keyFields: "id")
extend type MoneyUsageSubCategory @typePolicy(keyFields: "id")
extend type ImportedMailCategoryFilter @typePolicy(keyFields: "id")
extend type ImportedMailCategoryCondition @typePolicy(keyFields: "id")
extend type MoneyUsage @typePolicy(keyFields: "id")
extend type ImportedMail @typePolicy(keyFields: "id")
extend type Session @typePolicy(keyFields: "name")
